@page
@model tpweb.Pages.Alumnos.EntregarTareaModel
@{
    ViewData["Title"] = "Entregar tarea";
}

<h2 class="mb-4">Entregar Tarea</h2>

@if (Model.Tarea != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h4>@Model.Tarea.Titulo</h4>
            <p>@Model.Tarea.Descripcion</p>

            <p><strong>Materia:</strong> @Model.Tarea.Materia.Nombre</p>
            <p><strong>Fecha límite:</strong> @Model.Tarea.FechaEntrega.ToString("dd/MM/yyyy")</p>
        </div>
    </div>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Tu respuesta</label>
            <textarea asp-for="Respuesta" class="form-control" rows="6"></textarea>
        </div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ReturnUrl" />

        <button type="submit" class="btn btn-success">Enviar tarea</button>

        <a href="@Model.ReturnUrl" class="btn btn-secondary ms-2">
            Cancelar
        </a>
    </form>
}
else
{
    <div class="alert alert-danger">
        No se encontró la tarea.
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
