@page
@model tpweb.Pages.Asistencias.MisAsistenciasModel

@{
    ViewData["Title"] = "Mis Asistencias";
}

<h2 class="mb-4">Mis Asistencias</h2>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-7">
                <label class="form-label">Seleccioná materia</label>
                <select asp-for="MateriaId" asp-items="Model.Materias" class="form-select">
                    <option value="">Todas las materias</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label d-block">&nbsp;</label>
                <button type="submit" class="btn btn-primary w-100">Filtrar asistencias</button>
            </div>

            <div class="col-md-2">
                <label class="form-label d-block">&nbsp;</label>

                <a href="@Model.ReturnUrl"
                   class="btn btn-outline-secondary w-100">
                    Volver
                </a>
            </div>
        </form>

        <hr />

        @if (Model.Asistencias.Any())
        {
            <div class="alert alert-info">
                Total de registros: <strong>@Model.Asistencias.Count</strong>
            </div>
        }
    </div>
</div>

@if (Model.Asistencias.Any())
{
    <table class="table table-bordered table-hover">
        <thead class="table-primary">
            <tr>
                <th>Fecha</th>
                <th>Materia</th>
                <th>Presente</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Asistencias)
            {
                <tr>
                    <td>@a.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@a.Materia</td>
                    <td class="text-center">
                        @if (a.Presente)
                        {
                            <span class="text-success fw-bold fs-4">✔</span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold fs-4">✖</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-light">No hay asistencias para los filtros seleccionados.</div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}

