@page
@model tpweb.Pages.Asistencias.IndexModel

@{
    ViewData["Title"] = "Toma de Asistencia";
}

<h2 class="mb-4">Toma de Asistencia</h2>

<div class="mb-3">
    <strong>Fecha:</strong> @DateTime.Today.ToString("dd/MM/yyyy")
</div>

<form method="post">
    <input type="hidden" asp-for="MateriaId" />

    <table class="table table-bordered table-hover">
        <thead class="table-primary">
            <tr>
                <th>Alumno</th>
                <th>Presente</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alumno in Model.Alumnos)
            {
                <tr>
                    <td>@alumno.Nombre @alumno.Apellido</td>
                    <td class="text-center">
                        <input type="checkbox" name="presentes" value="@alumno.IdAlumno" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Guardar asistencia</button>
    <a asp-page="/Materias/Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}

