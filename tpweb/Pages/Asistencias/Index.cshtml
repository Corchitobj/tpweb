@page
@model tpweb.Pages.Asistencias.IndexModel

<h2>Asistencias</h2>

<form method="post">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Materia</th>
                <th>Asistencia</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alumno in Model.Alumnos)
            {
                <tr>
                    <td>@alumno.Nombre @alumno.Apellido</td>
                    <td>
                        <input type="checkbox" name="presentes" value="@alumno.IdAlumno" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}

