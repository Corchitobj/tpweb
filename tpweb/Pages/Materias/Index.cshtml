@page
@model tpweb.Pages.Materias.IndexModel

@{
    ViewData["Title"] = "Listado de Materias";

    // Obtener el rol desde la sesión
    var rol = HttpContext.Session.GetString("Rol");
}

<h2 class="mb-4">Listado de Materias</h2>

@if (rol == "Administrador")
{
    <div class="mb-3">
        <a asp-page="Create" class="btn btn-primary">Registrar Materia</a>
    </div>

    <form method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-6">
                <select name="CursoId" class="form-select form-select-sm">
                    <option value="">Todos los cursos</option>
                    @foreach (var curso in Model.Cursos)
                    {
                        <option value="@curso.Id" selected="@(curso.Id == Model.CursoId)">
                            @curso.Nombre
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary btn-sm w-100">Filtrar</button>
            </div>
        </div>
    </form>
}

<table class="table table-bordered table-hover">
    <thead class="table-primary">
        <tr>
            <th>Nombre</th>
            <th>Curso</th>
            @if (rol == "Administrador" || rol == "Preceptor")
            {
                <th>Docente</th>
            }
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Materia)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Curso?.Nombre</td> <!-- ✅ Sin fallback "Sin curso" -->
                @if (rol == "Administrador" || rol == "Preceptor")
                {
                    <td>@(item.Docente != null ? item.Docente.Nombre + " " + item.Docente.Apellido : "Sin docente")</td>
                }
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        @if (rol == "Administrador")
                        {
                            <a asp-page="./Edit" asp-route-id="@item.IdMateria" asp-route-CursoId="@Model.CursoId" class="btn btn-outline-warning btn-sm">Editar</a>
                            <a asp-page="./Details" asp-route-id="@item.IdMateria" asp-route-CursoId="@Model.CursoId" class="btn btn-outline-info btn-sm">Detalles</a>
                            <a asp-page="./Delete" asp-route-id="@item.IdMateria" asp-route-CursoId="@Model.CursoId" class="btn btn-outline-danger btn-sm">Eliminar</a> 
                        }

                        @if (rol == "Docente")
                        {
                        <a asp-page="/Materias/VerAlumnos" asp-route-materiaId="@item.IdMateria" class="btn btn-outline-info btn-sm">Alumnos</a>

                        <!-- Nuevo botón modal para Asistencia -->
                        <button type="button"
                                class="btn btn-outline-success btn-sm ms-1"
                                data-bs-toggle="modal"
                                data-bs-target="#asistenciaModal@item.IdMateria">
                            Asistencia
                        </button>

                        <!-- Modal Asistencia -->
                        <div class="modal fade" id="asistenciaModal@item.IdMateria" tabindex="-1"
                             aria-labelledby="asistenciaModalLabel@item.IdMateria" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header bg-success text-white">
                                        <h5 class="modal-title" id="asistenciaModalLabel@item.IdMateria">
                                            Opciones de Asistencia
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="d-grid gap-2">
                                            <a class="btn btn-success"
                                               asp-page="/Asistencias/Index"
                                               asp-route-materiaId="@item.IdMateria">
                                                Tomar asistencia
                                            </a>
                                            <a class="btn btn-secondary"
                                               asp-page="/Asistencias/Ver"
                                               asp-route-materiaId="@item.IdMateria">
                                                Historial
                                            </a>
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    data-bs-dismiss="modal">
                                                Cancelar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Tareas -->
                        <button type="button"
                                class="btn btn-outline-primary btn-sm ms-1"
                                data-bs-toggle="modal"
                                data-bs-target="#tareasModal@item.IdMateria">
                            Tareas
                        </button>

                        <div class="modal fade" id="tareasModal@item.IdMateria" tabindex="-1"
                             aria-labelledby="tareasModalLabel@item.IdMateria" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title" id="tareasModalLabel@item.IdMateria">
                                            Opciones de Tareas
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="d-grid gap-2">
                                            <a class="btn btn-primary"
                                               asp-page="/Tareas/Create"
                                               asp-route-materiaId="@item.IdMateria">
                                                Crear tarea
                                            </a>
                                            <a class="btn btn-primary"
                                               asp-page="/Tareas/Index"
                                               asp-route-materiaId="@item.IdMateria">
                                                Ver tareas
                                            </a>
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    data-bs-dismiss="modal">
                                                Cancelar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Materia.Any())
{
    <div class="alert alert-warning">No se encontraron materias para el curso seleccionado.</div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}

