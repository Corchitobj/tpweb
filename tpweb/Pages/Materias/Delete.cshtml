@page
@model tpweb.Pages.Materias.DeleteModel

@{
    ViewData["Title"] = "Eliminar Materia";
}

<h1>Eliminar Materia</h1>

<h3>¿Estás seguro que querés eliminar esta materia?</h3>
<hr />

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Materia.Nombre</dd>

    <dt class="col-sm-2">Curso</dt>
    <dd class="col-sm-10">@Model.Materia.Curso?.Nombre</dd>

    <dt class="col-sm-2">Docente</dt>
    <dd class="col-sm-10">@($"{Model.Materia.Docente?.Apellido}, {Model.Materia.Docente?.Nombre}")</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Materia.IdMateria" />
    <input type="submit" value="Eliminar" class="btn btn-danger" /> |
    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
</form>


