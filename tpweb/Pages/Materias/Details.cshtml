@page
@model tpweb.Pages.Materias.DetailsModel

@{
    ViewData["Title"] = "Detalles de Materia";
}

<h1>Detalles de Materia</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Materia.Nombre</dd>

    <dt class="col-sm-2">Curso</dt>
    <dd class="col-sm-10">@Model.Materia.Curso?.Nombre</dd>

    <dt class="col-sm-2">Docente</dt>
    <dd class="col-sm-10">@($"{Model.Materia.Docente?.Apellido}, {Model.Materia.Docente?.Nombre}")</dd>
</dl>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Materia.IdMateria">Editar</a> |
    <a asp-page="./Index">Volver al listado</a>
</div>


