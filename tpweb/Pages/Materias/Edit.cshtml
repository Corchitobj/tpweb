@page
@model tpweb.Pages.Materias.EditModel

@{
    ViewData["Title"] = "Editar Materia";
}

<h1>Editar Materia</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Materia.IdMateria" />

            <!-- Nombre -->
            <div class="form-group mb-3">
                <label asp-for="Materia.Nombre" class="form-label">Nombre</label>
                <input asp-for="Materia.Nombre" class="form-control" />
                <span asp-validation-for="Materia.Nombre" class="text-danger"></span>
            </div>

            <!-- Curso -->
            <div class="form-group mb-3">
                <label class="form-label">Curso</label>
                <select asp-for="Materia.CursoId" class="form-select" asp-items="Model.CursosSelect"></select>
                <span asp-validation-for="Materia.CursoId" class="text-danger"></span>
            </div>

            <!-- Docente -->
            <div class="form-group mb-3">
                <label class="form-label">Docente</label>
                <select asp-for="Materia.DocenteId" class="form-select" asp-items="Model.DocentesSelect"></select>
                <span asp-validation-for="Materia.DocenteId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

