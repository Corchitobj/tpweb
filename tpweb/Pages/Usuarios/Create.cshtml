@page
@model tpweb.Pages.Usuarios.CreateModel

@{
    ViewData["Title"] = "Crear Usuario";
}

<h1>Crear Usuario</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="form-group">
                <label asp-for="Usuario.Nombre"></label>
                <input asp-for="Usuario.Nombre" class="form-control" />
                <span asp-validation-for="Usuario.Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Usuario.Apellido"></label>
                <input asp-for="Usuario.Apellido" class="form-control" />
                <span asp-validation-for="Usuario.Apellido" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Usuario.Dni"></label>
                <input asp-for="Usuario.Dni" class="form-control" />
                <span asp-validation-for="Usuario.Dni" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Usuario.Mail"></label>
                <input asp-for="Usuario.Mail" class="form-control" />
                <span asp-validation-for="Usuario.Mail" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Usuario.UsuarioNombre"></label>
                <input asp-for="Usuario.UsuarioNombre" class="form-control" />
                <span asp-validation-for="Usuario.UsuarioNombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Usuario.Contraseña"></label>
                <input asp-for="Usuario.Contraseña" class="form-control" />
                <span asp-validation-for="Usuario.Contraseña" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Usuario.Rol.IdRol">Rol</label>
                <select asp-for="Usuario.Rol.IdRol" class="form-control" asp-items="Model.RolesSelect"></select>
                <span asp-validation-for="Usuario.Rol.IdRol" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Crear</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

