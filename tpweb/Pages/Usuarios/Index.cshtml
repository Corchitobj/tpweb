@page
@model tpweb.Pages.Usuarios.IndexModel

@{
    ViewData["Title"] = "Listado de Usuarios";
}

<h2 class="mb-4">Listado de Usuarios</h2>

<div class="mb-3">
    <a asp-page="Create" class="btn btn-primary">Registrar Usuario</a>
</div>

<!-- 🔍 Filtros -->
<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-6">
            <input type="text" name="FiltroTexto" value="@Model.FiltroTexto" class="form-control form-control-sm" placeholder="Buscar por nombre, apellido o usuario..." />
        </div>
        <div class="col-md-4">
            <select name="RolId" class="form-select form-select-sm">
                <option value="">Todos los roles</option>
                @foreach (var rol in Model.Roles)
                {
                    <option value="@rol.IdRol" selected="@(rol.IdRol == Model.RolId)">
                        @rol.Nombre
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary btn-sm w-100">Filtrar</button>
        </div>
    </div>
</form>

<!-- 📋 Tabla de usuarios -->
<table class="table table-bordered table-hover">
    <thead class="table-primary">
        <tr>
            <th>Apellido</th>
            <th>Nombre</th>
            <th>DNI</th>
            <th>Mail</th>
            <th>Usuario</th>
            <th>Rol</th>
            <th style="width: 180px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Usuario)
        {
            <tr>
                <td>@item.Apellido</td>
                <td>@item.Nombre</td>
                <td>@item.Dni</td>
                <td>@item.Mail</td>
                <td>@item.UsuarioNombre</td>
                <td>@item.Rol?.Nombre</td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        <a asp-page="./Edit" asp-route-id="@item.IdUsuario" class="btn btn-outline-warning btn-sm">Editar</a>
                        <a asp-page="./Details" asp-route-id="@item.IdUsuario" class="btn btn-outline-info btn-sm">Detalles</a>
                        <a asp-page="./Delete" asp-route-id="@item.IdUsuario" class="btn btn-outline-danger btn-sm">Eliminar</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Usuario.Any())
{
    <div class="alert alert-warning">No se encontraron usuarios que coincidan con los filtros.</div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}


